node_modules/
# Without slash too: the trailing-slash form only matches directories, so a
# symlinked node_modules (handy for sharing an install between checkouts) would
# otherwise be committed as a link into someone's filesystem.
node_modules
*.DS_Store
*.bak
/tmp/

# SAM build artifacts
.aws-sam/

# Local deployment config — never commit (your account ID, FS ID, profile, etc.)
config.env
